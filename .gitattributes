# Normalize all text files to LF in the repository and working tree.
* text=auto eol=lf

# Keep Windows command and PowerShell scripts with CRLF line endings.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Never normalize binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
*.mp3 binary
*.wasm binary
