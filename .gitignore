# =============================================================================
# OMA Personal repo (oma-personal) — .gitignore
# Created 2026-05-23 in Phase 10
# =============================================================================

# Serena MCP local memory (per-machine, transient)
.serena/
**/.serena/

# Test / scratch workspaces (local-only)
oma-3vendor-live-test/
oma-derived-test-*/

# User personal projects (kept private even within this private repo)
sample-rights-analysis/

# Empty Korean placeholder folders
감정평가사/
공인중개사/

# OMA upgrade backups (rotating, large, local-only)
backups/

# Node / Bun
node_modules/
*.log
*.tsbuildinfo

# OS / IDE temp
.DS_Store
Thumbs.db
*.tmp
*.swp

# Local environment files (defense in depth — there are none today)
.env
.env.local
.env.*.local

# Promptfoo eval intermediate output (regenerated on each run)
oma-eval/results.json
oma-eval/.promptfoo/
oma-eval/output.html

# OMA agent results from local spawns (machine-specific session traces)
**/.agents/results/result-*-session-*.md
.agents/state/
**/.agents/state/

# Debug scratch files
agy_debug.txt
*_debug.txt

# oma docs generated artifacts
docs/generated/

# oh-my-agent runtime (local artifacts — do not commit)
.antigravitycli/
.agents/results/

# === 2026-06-05 cleanup: keep-on-disk vendored tools + runtime state ===
# Vendored MCP tool clones (referenced by .mcp.json; kept on disk, not source)
chrome-devtools-mcp/
kordoc/
# Vendor runtime state / local data caches
.grok/
.kiro/
opencrab_data/
cache/
# Audit scratch workspaces (regenerated)
codex-audit-workspace/
codex-audit-derived-auto/
# oma-goal runtime ledger (regenerated by `oma-goal init`; brief.md & .gitkeep stay tracked)
.agents/goals/goals.json
.agents/goals/ledger.jsonl
.agents/goals/evidence/*
!.agents/goals/evidence/.gitkeep
