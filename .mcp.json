{
  "mcpServers": {
    "chrome-devtools": {
      "command": "node",
      "args": [
        "C:/Users/user/AI_Orchestra_Lab/projects/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js",
        "--no-usage-statistics",
        "--isolated"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project",
        ".",
        "--open-web-dashboard",
        "false"
      ],
      "env": {
        "SERENA_LOG_LEVEL": "info"
      }
    },
    "korean-law": {
      "command": "korean-law-mcp"
    },
    "kordoc": {
      "command": "node",
      "args": [
        "C:/Users/user/AI_Orchestra_Lab/projects/kordoc/dist/mcp.js"
      ]
    }
  }
}
